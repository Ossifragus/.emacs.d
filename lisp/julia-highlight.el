;; Enhanced font lock rules for julia-mode
(with-eval-after-load 'julia-mode
  (font-lock-add-keywords
   'julia-mode
   `((,(regexp-opt julia-highlight-functions 'symbols) . font-lock-function-name-face)
     (,(regexp-opt julia-highlight-constants 'symbols) . font-lock-constant-face)
     ("\\<\\(\\sw+\\) ?\\([!(]\\)" 1 font-lock-function-name-face))))

;; Enhanced font lock rules for julia-ts-mode (tree-sitter)
(with-eval-after-load 'julia-ts-mode
  (font-lock-add-keywords
   'julia-ts-mode
   '(("\\<\\(\\(?:\\sw\\|\\s_\\)+\\)\\s-*\\(?:\\.\\)?(" 1 font-lock-function-name-face))))

(provide 'julia-highlight)
